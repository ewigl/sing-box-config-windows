{
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "dns_cf",
        "server": "1.1.1.1"
      },
      {
        "type": "tls",
        "tag": "dns_ali",
        "server": "223.5.5.5"
      },
      {
        "type": "local",
        "tag": "dns_local"
      }
    ],
    "rules": [
      {
        "rule_set": ["cn"],
        "server": "dns_ali"
      },
      {
        "action": "evaluate",
        "server": "dns_cf"
      },
      {
        "match_response": true,
        "rule_set": ["geoip-cn"],
        "server": "dns_ali"
      },
      {
        "action": "route",
        "server": "dns_cf"
      }
    ],
    "strategy": "ipv4_only"
  }
}
