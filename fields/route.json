{
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "private"
          },
          {
            "ip_is_private": true
          }
        ],
        "outbound": "⚡ Direct"
      },
      {
        "protocol": "bittorrent",
        "outbound": "⚡ Direct"
      },
      {
        "process_name": ["piliplus.exe", "Weixin.exe", "WeChatAppEx.exe"],
        "outbound": "⚡ Direct"
      },
      {
        "process_name": [
          "eldenring.exe",
          "NoRestForTheWicked.exe",
          "ForzaHorizon4.exe"
        ],
        "outbound": "🎮 Games"
      },
      {
        "rule_set": "microsoft",
        "outbound": "Ⓜ Microsoft"
      },
      {
        "rule_set": "steam@cn",
        "outbound": "🎮 SteamCN"
      },
      {
        "rule_set": "cn",
        "outbound": "⚡ Direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": ["cn", "microsoft", "private", "steam@cn"],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/sing/geo/geosite/{tag}.srs"
      }
    ],
    "final": "🚀 Default",
    "find_process": true,
    "auto_detect_interface": true,
    "default_domain_resolver": "dns_ali",
    "default_http_client": "default-http-client"
  }
}
