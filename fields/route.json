{
  "route": {
    "rule_set": [
      {
        "tag": ["cn", "microsoft", "steam@cn"],
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/sing/geo/geosite/{tag}.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/refs/heads/sing/geo/geoip/cn.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "⚡ Direct"
      },
      {
        "protocol": "bittorrent",
        "outbound": "⚡ Direct"
      },
      {
        "process_name": ["piliplus.exe", "Weixin.exe", "WeChatAppEx.exe"],
        "outbound": "⚡ Direct"
      },
      {
        "process_name": [
          "eldenring.exe",
          "NoRestForTheWicked.exe",
          "ForzaHorizon4.exe"
        ],
        "outbound": "🎮 Games"
      },
      {
        "rule_set": "microsoft",
        "outbound": "Ⓜ Microsoft"
      },
      {
        "rule_set": ["cn", "geoip-cn"],
        "outbound": "⚡ Direct"
      },
      {
        "rule_set": "steam@cn",
        "outbound": "🎮 SteamCN"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "dns_local",
    "default_http_client": "default-http-client",
    "final": "🚀 Default",
    "find_process": true
  }
}
